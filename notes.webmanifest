{
  "id": "./notes.html",
  "name": "RRnotes",
  "short_name": "RRnotes",
  "description": "A paper notebook for writing with a stylus.",
  "start_url": "./notes.html",
  "scope": "./notes",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#dcdcd5",
  "theme_color": "#dcdcd5",
  "icons": [
    { "src": "notes-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "notes-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "notes-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
